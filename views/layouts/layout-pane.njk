{% extends "_generic.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{# If the theme ends in '…', then we nest the caption inside the H1 so that the
  H1 becomes e.g. 'Ask users for dates'. Otherwise, we put it before the H1. #}
{% set includeThemeInPageHeading = theme and "…" in theme %}

{% block container %}
<div class="app-split-pane app-width-container app-container-wrapper">
  <div class="app-split-pane__nav">
    {% include "_subnav.njk" %}
  </div>
  <div class="app-split-pane__content">
    {{ govukBreadcrumbs({
      classes: "app-breadcrumbs",
      items: getAncestorPages(permalink)
    }) }}
    <main id="main-content" class="app-content" role="main">
      <h1 class="govuk-heading-xl {%- if status %} govuk-!-margin-bottom-5{% endif %}">
        {% if includeThemeInPageHeading %}
        <span class="govuk-caption-xl">
          {{ theme | replace("…", "") }}
        </span>
        {% endif %}
        {{ title }}
      </h1>

      {% if status %}
      <aside class="govuk-!-margin-bottom-8" aria-label="Guidance status">
        <strong class="govuk-tag govuk-!-margin-bottom-2">
          {{ status }}
        </strong>
        <p class="govuk-body">{{ statusMessage | safe }}</p>
      </aside>
      {% endif %}

      {% if showPageNav %}
        <ul class="app-page-navigation">
          {% for heading in headings %}
            {% if heading.depth == 2 %}
              <li class="app-page-navigation__item">
                <a class="govuk-link" href="#{{ heading.url}}">
                  {{ heading.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if title == "Generic header" or title == "Generic header - Change history" %}
        <ul class="app-guidance-tabs">
          <li class="app-guidance-tabs__item{% if title == "Generic header" %} app-guidance-tabs__item--current{% endif %}">
            <a href="/components/generic-header" class="app-guidance-tabs__link">Guidance</a>
          </li>
          <li class="app-guidance-tabs__item{% if title == "Generic header - Change history" %} app-guidance-tabs__item--current{% endif %}">
            <a href="/components/generic-header/history" class="app-guidance-tabs__link">Change history</a>
          </li>
        </ul>
      {% endif %}

      <div class="app-prose-scope">
        {{ contents | safe }}
      </div>

      {# No JS fallback to show overview #}
      {% if showSubNav %}
        {% include "_category-nav.njk" %}
      {% endif %}

      {% if section %}
        {% include "_contact-panel.njk" %}
      {% endif %}
    </main>
  </div>
  {% include "_back-to-top.njk" %}
</div>
{% endblock %}

{% block govukFooter %}
  {% include "_footer.njk" %}
{% endblock %}
